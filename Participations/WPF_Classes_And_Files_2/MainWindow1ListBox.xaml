<Window x:Class="WPF_Classes_And_Files_2.MainWindow1ListBox"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WPF_Classes_And_Files_2"
        mc:Ignorable="d"
        Title="MainWindow1ListBox" Height="450" Width="800">
    <Grid>
        <ListBox x:Name="lstSales" d:ItemsSource="{d:SampleData ItemCount=5}" Margin="360,0,0,0"/>
        <Label Content="Select a payment type" HorizontalAlignment="Left" Margin="54,74,0,0" VerticalAlignment="Top"/>
        <ComboBox x:Name="cboPaymentTypes" HorizontalAlignment="Left" Margin="88,105,0,0" VerticalAlignment="Top" Width="120" SelectionChanged="cboPaymentTypes_SelectionChanged"/>
        <Button x:Name="btnSave" Content="Save" HorizontalAlignment="Left" Margin="54,306,0,0" VerticalAlignment="Top" Height="48" Width="127"/>

    </Grid>
</Window>
