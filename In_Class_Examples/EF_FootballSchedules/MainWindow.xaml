<Window x:Class="EF_FootballSchedules.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:EF_FootballSchedules"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid Margin="400,0,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <ListBox x:Name="lstHome" d:ItemsSource="{d:SampleData ItemCount=5}" Margin="10,105,0,0" Grid.RowSpan="2"/>
        <ListBox x:Name="lstAway" d:ItemsSource="{d:SampleData ItemCount=5}" Margin="-400,105,420,0" Grid.RowSpan="2"/>
        <ComboBox x:Name="cboSeason" HorizontalAlignment="Left" Margin="-140,9,0,0" VerticalAlignment="Top" Width="120" Grid.Row="1" SelectionChanged="ComboBox_SelectionChanged"/>
        <Label Content="Select a season" HorizontalAlignment="Left" Margin="-184,18,0,0" VerticalAlignment="Top"/>

    </Grid>
</Window>
